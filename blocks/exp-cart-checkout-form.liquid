    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#2E2A39",
      "info": "Border color for inputs and separators"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Input Background",
      "default": "#FFFFFF",
      "info": "Background color for inputs, textareas, and selectors"
    },
    {
      "type": "color",
      "id": "input_foreground",
      "label": "Input Foreground",
      "default": "#1F2937",
      "info": "Text and placeholder color for inputs, textareas, and selectors"
    },
    {
      "type": "header",
      "content": "Shape"
    },
    {
      "type": "range",
      "id": "input_rounded",
