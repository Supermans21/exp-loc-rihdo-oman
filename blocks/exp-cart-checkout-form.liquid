    },
    {
      "type": "text",
      "id": "step1_button_label",
      "label": "Step 1 Button Label",
      "default": "Continue"
    },
    {
      "type": "text",
      "id": "step2_label",
      "label": "Step 2 Tab Label",
      "default": "Detail Address"
    },
    {
      "type": "text",
      "id": "step2_heading",
      "label": "Step 2 Heading",
      "default": "Detail Address"
    },
    {
      "type": "text",
      "id": "back_button_label",
      "label": "Back Button Label",
      "default": "Back"
    },
    {
      "type": "text",
      "id": "complete_button_label",
      "label": "Save Address Button Label",
