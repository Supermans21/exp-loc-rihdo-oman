      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_rounded",
      "label": "Button Rounded",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Text Appearance"
    },
    {
      "type": "select",
