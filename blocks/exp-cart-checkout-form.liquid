      "info": "Optional. Leave blank to use the built-in location pin icon."
    },
    {
      "type": "text",
      "id": "trigger_heading",
      "label": "Empty Trigger Title",
      "default": "Shipping Address"
    },
    {
      "type": "text",
      "id": "trigger_empty_text",
      "label": "Empty Trigger Subtitle",
      "default": "Add an address to pre-fill checkout automatically"
    },
    {
      "type": "text",
      "id": "add_address_button_label",
      "label": "Add Address Label",
      "default": "Add Address"
    },
    {
      "type": "text",
      "id": "change_button_label",
      "label": "Change Address Label",
      "default": "Change"
    },
    {
      "type": "checkbox",
